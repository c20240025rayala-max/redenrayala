>
    <div class="mx-auto max-w-6xl">
        <p class="text-lg font-bold">
            Reden Rayala
        </p>
        
        <div class="mt-6 border-t border-slate-700 pt-5">
            <p class="text-sm text-slate-400">
                &copy; {currentYear} Reden Rayala. All rights reserved.
            </p>
        </div>
    </div>
</footer>
