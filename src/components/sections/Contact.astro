<section id="contact" class="reveal bg-slate-50 px-6 py-20 dark:bg-slate-900/60">
    <div class="mx-auto max-w-6xl">
        <h2 class="text-3xl font-bold tracking-tight text-pink-500 sm:text-4xl">
            Let's build together!
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            Have a project or opportunity in mind? I’d be happy to hear from you.
        </p>
        <form id="contactForm" action="#" class="mt-8 flex max-w-xl flex-col gap-4 text-left">
            <label class="text-base font-medium" for="name">Name</label>
            <input class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-base dark:border-slate-700 dark:bg-slate-950" type="text" id="name" name="name" placeholder="Your name" required />

            <label class="text-base font-medium" for="email">Email</label>
            <input class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-base dark:border-slate-700 dark:bg-slate-950" type="email" id="email" name="email" placeholder="you@example.com" required />

            <label class="text-base font-medium" for="message">Message</label>
            <textarea class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-base dark:border-slate-700 dark:bg-slate-950" id="message" name="message" rows="5" placeholder="Tell me about your project..." required></textarea>

            <button class="self-start rounded-[10px] bg-black px-6 py-3 text-base font-semibold text-white transition-colors duration-300 hover:bg-pink-400 hover:text-black dark:bg-slate-700" type="submit">
                Send Message
            </button>
        </form>
    </div>
</section>
