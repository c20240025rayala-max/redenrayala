---
const currentYear = new Date().getFullYear();
---

<footer
    id="footer"
    class="mt-auto bg-slate-100 px-6 py-8 text-center text-slate-800 dark:bg-slate-900 dark:text-slate-100"
>
    <div class="mx-auto max-w-6xl">
        <p class="text-lg font-bold">
            Reden Rayala
        </p>
        
        <div class="mt-6 border-t border-slate-300 pt-5 dark:border-slate-700">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                &copy; {currentYear} Reden Rayala. All rights reserved.
            </p>
        </div>
    </div>
</footer>
